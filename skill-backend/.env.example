# SkillXchange Backend — Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.mongodb.net/skillxchange?retryWrites=true&w=majority

# Secret used to sign JWT tokens (use a long random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Port (Render auto-assigns this — do not set manually on Render)
PORT=5000

# Frontend origin for CORS (e.g. https://your-app.vercel.app in production)
CLIENT_ORIGIN=http://localhost:5173
